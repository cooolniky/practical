#!/bin/bash

# Laravel Docker Setup Script - SINGLE COMPREHENSIVE SETUP
# This script handles everything: permissions, Docker setup, Laravel installation
# 
# USAGE: Just run: ./.setup
#
# This script will:
# ✅ Fix all permission issues automatically
# ✅ Set up Docker containers (PHP 8.3, MySQL 8.0, Redis, Nginx)
# ✅ Install Laravel 11 dependencies
# ✅ Run database migrations and seeders
# ✅ Generate application key
# ✅ Make your app accessible at http://localhost:8000
#
# NO OTHER FILES NEEDED - this is the only file you need to run!

# Exit on any error, but handle errors gracefully
set -e
trap 'handle_error $? $LINENO' ERR

echo "🚀 Setting up Laravel Application with Docker..."
echo "📋 This is the ONLY setup file you need - it handles everything!"
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Configuration
MAX_RETRIES=3
WAIT_TIME=5
DB_WAIT_TIME=30

# Function to print colored output
print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_step() {
    echo -e "${PURPLE}[STEP]${NC} $1"
}

print_debug() {
    echo -e "${CYAN}[DEBUG]${NC} $1"
}

# Error handler
handle_error() {
    local exit_code=$1
    local line_number=$2
    print_error "Script failed at line $line_number with exit code $exit_code"
    print_error "Cleaning up..."
    docker-compose down --volumes --remove-orphans 2>/dev/null || true
    exit $exit_code
}

# Function to retry commands
retry_command() {
    local cmd="$1"
    local description="$2"
    local max_attempts=${3:-$MAX_RETRIES}
    local wait_time=${4:-$WAIT_TIME}
    
    for ((i=1; i<=max_attempts; i++)); do
        print_status "Attempt $i/$max_attempts: $description"
        if eval "$cmd"; then
            print_success "$description completed successfully"
            return 0
        else
            if [ $i -lt $max_attempts ]; then
                print_warning "Attempt $i failed. Retrying in ${wait_time}s..."
                sleep $wait_time
            else
                print_error "$description failed after $max_attempts attempts"
                return 1
            fi
        fi
    done
}

# Function to wait for service to be ready
wait_for_service() {
    local service=$1
    local port=$2
    local max_wait=${3:-60}
    local wait_interval=2
    local elapsed=0
    
    print_status "Waiting for $service to be ready on port $port..."
    
    while [ $elapsed -lt $max_wait ]; do
        if docker-compose exec app nc -z localhost $port 2>/dev/null; then
            print_success "$service is ready!"
            return 0
        fi
        sleep $wait_interval
        elapsed=$((elapsed + wait_interval))
        echo -n "."
    done
    
    echo ""
    print_error "$service failed to start within ${max_wait}s"
    return 1
}

# Function to check prerequisites
check_prerequisites() {
    print_step "Checking prerequisites..."
    
    # Check if we're in the right directory
    if [ ! -f "composer.json" ]; then
        print_error "composer.json not found. Please run this script from the Laravel root directory."
        exit 1
    fi
    
    # Check Docker installation
    if ! command -v docker &> /dev/null; then
        print_error "Docker is not installed. Please install Docker first."
        print_error "Visit: https://docs.docker.com/get-docker/"
        exit 1
    fi
    
    # Check Docker Compose installation
    if ! command -v docker-compose &> /dev/null; then
        print_error "Docker Compose is not installed. Please install Docker Compose first."
        print_error "Visit: https://docs.docker.com/compose/install/"
        exit 1
    fi
    
    # Check if Docker daemon is running
    if ! docker info &> /dev/null; then
        print_error "Docker daemon is not running. Please start Docker first."
        exit 1
    fi
    
    # Check Docker Compose file exists
    if [ ! -f "docker-compose.yml" ]; then
        print_error "docker-compose.yml not found in current directory."
        exit 1
    fi
    
    # Check available disk space (require at least 2GB)
    available_space=$(df . | tail -1 | awk '{print $4}')
    required_space=2097152  # 2GB in KB
    if [ "$available_space" -lt "$required_space" ]; then
        print_warning "Low disk space detected. At least 2GB recommended."
    fi
    
    print_success "All prerequisites met!"
}

# Check if Docker is installed
if ! command -v docker &> /dev/null; then
    print_error "Docker is not installed. Please install Docker first."
    exit 1
fi

# Check if Docker Compose is installed
if ! command -v docker-compose &> /dev/null; then
    print_error "Docker Compose is not installed. Please install Docker Compose first."
    exit 1
fi

print_status "Docker and Docker Compose found!"

# Run prerequisite checks
check_prerequisites

# Create .env file if it doesn't exist
if [ ! -f .env ]; then
    print_step "Setting up environment configuration..."
    if [ -f .env.example ]; then
        cp .env.example .env
        print_success ".env file created from .env.example!"
    else
        print_warning ".env.example not found. Creating basic .env file..."
        cat > .env << EOF
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="\${APP_NAME}"
EOF
        print_success "Basic .env file created!"
    fi
else
    print_warning ".env file already exists. Keeping existing configuration."
fi

# Fix common .env issues automatically
print_step "Fixing common configuration issues..."
if [ -f .env ]; then
    # Fix session driver to use Redis instead of database (more reliable)
    if grep -q "SESSION_DRIVER=database" .env; then
        print_status "Switching session driver from database to Redis for better reliability..."
        sed -i 's/SESSION_DRIVER=database/SESSION_DRIVER=redis/g' .env
    fi
    
    # Ensure Redis is configured properly
    if ! grep -q "REDIS_HOST=redis" .env; then
        print_status "Adding Redis configuration..."
        echo "" >> .env
        echo "REDIS_HOST=redis" >> .env
        echo "REDIS_PASSWORD=null" >> .env
        echo "REDIS_PORT=6379" >> .env
    fi
fi

# Stop any running containers
print_step "Cleaning up existing containers..."
docker-compose down --volumes --remove-orphans 2>/dev/null || true

# Remove any orphaned volumes
print_status "Removing orphaned Docker volumes..."
docker volume prune -f 2>/dev/null || true

# Clean up problematic files on host system
print_status "Cleaning up problematic files..."
rm -rf vendor/ 2>/dev/null || true
rm -f composer.lock 2>/dev/null || true

# Build and start the containers
print_step "Building and starting Docker containers..."
retry_command "docker-compose up -d --build" "Docker container startup"

# Verify containers are running
print_status "Verifying container status..."
sleep 5
if ! docker-compose ps | grep -q "Up"; then
    print_error "Some containers failed to start properly"
    docker-compose logs
    exit 1
fi

# Fix permissions and ownership issues first (COMPREHENSIVE FIX)
print_step "Fixing permissions and ownership..."

# Get current user info
CURRENT_USER=$(whoami)
CURRENT_GROUP=$(id -gn)
print_status "Current user: $CURRENT_USER:$CURRENT_GROUP"

# Stop any running containers first to avoid conflicts
docker-compose down 2>/dev/null || true

# Fix ownership of the entire project to current user
if sudo chown -R $CURRENT_USER:$CURRENT_GROUP . 2>/dev/null; then
    print_status "Fixed ownership to $CURRENT_USER:$CURRENT_GROUP"
else
    print_warning "Could not change ownership (may not be needed)"
fi

# Set proper permissions
find . -type d -exec chmod 755 {} \; 2>/dev/null || true
find . -type f -exec chmod 644 {} \; 2>/dev/null || true

# Make scripts executable
chmod +x artisan .setup fix-permissions.sh .setup-fixed 2>/dev/null || true

# Create and fix Laravel specific directories with proper permissions
mkdir -p storage/{app,framework/{cache,sessions,views},logs} bootstrap/cache vendor .cache/composer 2>/dev/null || true
chmod -R 777 storage bootstrap/cache .cache 2>/dev/null || true

# Fix .env file permissions
if [ -f .env ]; then
    chmod 666 .env 2>/dev/null || true
fi

# Fix git ownership issue early and suppress all git warnings
git config --global --add safe.directory $(pwd) 2>/dev/null || true
git config --global --add safe.directory "/var/www" 2>/dev/null || true
export GIT_DISCOVERY_ACROSS_FILESYSTEM=1

# Create essential Laravel directories inside containers after startup
print_status "Creating essential directories inside containers..."
docker-compose up -d --build >/dev/null 2>&1 || true
sleep 3
docker-compose exec -T app mkdir -p /var/www/storage/framework/{sessions,views,cache} /var/www/bootstrap/cache 2>/dev/null || true
docker-compose exec -T app chmod -R 777 /var/www/storage /var/www/bootstrap/cache 2>/dev/null || true

# Clean up problematic vendor files on host system if they exist
print_status "Cleaning up problematic vendor files..."
rm -rf vendor/ composer.lock .cache/* bootstrap/cache/* storage/logs/* 2>/dev/null || true

# Remove any Docker volumes that might have permission issues
docker volume prune -f 2>/dev/null || true

print_success "Permissions fixed successfully"

# Wait for database to be ready with proper health check
print_step "Waiting for database to be ready..."
retry_command "docker-compose exec -T db pg_isready -U laravel -d laravel" "Database connection" 6 10

# Install PHP dependencies with improved method
print_step "Installing PHP dependencies with Composer..."

# Method 1: Try direct installation first
if docker-compose exec -T app bash -c 'cd /var/www && composer install --no-interaction --prefer-dist --optimize-autoloader --no-scripts' 2>/dev/null; then
    print_success "Composer dependencies installed successfully (direct method)"
else
    print_warning "Direct installation failed, trying isolated method..."
    
    # Method 2: Use isolated temp directory method (more reliable)
    print_status "Installing dependencies in isolated environment..."
    
    if docker-compose exec -T app bash -c "
        cd /tmp && 
        cp /var/www/composer.json . && 
        HOME=/tmp COMPOSER_HOME=/tmp composer install --no-interaction --prefer-dist --optimize-autoloader --no-scripts --quiet
    "; then
        print_status "Dependencies installed successfully in temp directory"
        
        # Copy vendor directory and composer.lock to host
        print_status "Copying dependencies to host..."
        docker cp $(docker-compose ps -q app):/tmp/vendor ./ 2>/dev/null || true
        docker cp $(docker-compose ps -q app):/tmp/composer.lock ./ 2>/dev/null || true
        
        print_success "Composer dependencies installed successfully (isolated method)"
    else
        print_error "Failed to install Composer dependencies with both methods"
        print_error "Please check the logs above for details"
        exit 1
    fi
fi

# Generate application key
print_step "Generating application key..."
retry_command "docker-compose exec -T app php artisan key:generate --force" "Application key generation"

# Clear and cache config
print_step "Clearing and caching configuration..."
docker-compose exec -T app php artisan config:clear || true
docker-compose exec -T app php artisan config:cache || print_warning "Config caching failed - continuing without cache"

# Test database connection before migrations
print_status "Testing database connection..."
if docker-compose exec -T app php artisan migrate:status >/dev/null 2>&1 || docker-compose exec -T db pg_isready -U laravel -d laravel >/dev/null 2>&1; then
    print_success "Database connection is working"
else
    print_error "Cannot connect to database. Please check database configuration."
    docker-compose logs db
    exit 1
fi

# Fix session configuration automatically
print_step "Configuring session driver..."
if grep -q "SESSION_DRIVER=database" .env; then
    print_status "Detected database session driver - creating sessions table..."
    docker-compose exec -T app php artisan session:table --force 2>/dev/null || true
else
    print_status "Using Redis session driver (recommended)"
fi

# Run database migrations
print_step "Running database migrations..."
retry_command "docker-compose exec -T app php artisan migrate --force" "Database migrations"

# Seed the database (if seeders exist)
print_step "Seeding the database..."
if docker-compose exec -T app php artisan db:seed --force 2>/dev/null; then
    print_success "Database seeded successfully!"
else
    print_warning "Database seeding failed or no seeders found - continuing setup"
fi

# Set proper permissions
print_step "Setting proper permissions..."
docker-compose exec -T app chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache 2>/dev/null || true
docker-compose exec -T app chmod -R 775 /var/www/storage /var/www/bootstrap/cache 2>/dev/null || true
docker-compose exec -T app chmod -R 755 /var/www/vendor 2>/dev/null || true

# Clear all caches
print_step "Clearing application caches..."
docker-compose exec -T app php artisan cache:clear || true
docker-compose exec -T app php artisan route:clear || true
docker-compose exec -T app php artisan view:clear || true
docker-compose exec -T app php artisan optimize:clear || true

# Install and build frontend assets (if needed)
if [ -f "package.json" ]; then
    print_step "Setting up frontend assets..."
    
    # Check if Node.js is available in container
    if docker-compose exec -T app which node &>/dev/null; then
        retry_command "docker-compose exec -T app npm install" "NPM package installation"
        
        # Try different build commands
        if docker-compose exec -T app npm run build 2>/dev/null; then
            print_success "Frontend assets built successfully!"
        elif docker-compose exec -T app npm run dev 2>/dev/null; then
            print_success "Frontend assets built in development mode!"
        elif docker-compose exec -T app npm run production 2>/dev/null; then
            print_success "Frontend assets built for production!"
        else
            print_warning "Frontend build failed - continuing without frontend assets"
        fi
    else
        print_warning "Node.js not available in container - skipping frontend build"
    fi
else
    print_status "No package.json found - skipping frontend setup"
fi

# Show container status
print_step "Checking final container status..."
docker-compose ps

# Run comprehensive health checks
print_step "Running application health checks..."

# Check Laravel version
LARAVEL_VERSION=$(docker-compose exec -T app php artisan --version 2>/dev/null || echo "Unknown")
print_status "Laravel Version: $LARAVEL_VERSION"

# Check database connection
if docker-compose exec -T app php artisan migrate:status >/dev/null 2>&1; then
    print_success "Database connection verified"
else
    print_warning "Database connection could not be verified"
fi

# Check Redis connection (if configured)
if docker-compose exec -T redis redis-cli ping 2>/dev/null | head -1 | grep -q "PONG"; then
    print_success "Redis connection verified"
else
    print_warning "Redis connection failed or not configured"
fi

# Test application routes
print_status "Testing application routes..."
docker-compose exec -T app php artisan route:list --compact 2>/dev/null | head -10 || print_warning "Could not list routes"

# Display access information
echo ""
print_success "🎉 Setup completed successfully!"
echo ""
echo "📋 Application Information:"
echo "   🌐 Application URL: http://localhost:8000"
echo "   🗄️  Database Host: localhost:5432"
echo "   📊 Redis Host: localhost:6379"
echo "   🐳 Container Status: $(docker-compose ps --services | wc -l) services running"
echo ""
echo "🔧 Useful Commands:"
echo "   View logs: docker-compose logs -f"
echo "   Stop services: docker-compose down"
echo "   Start services: docker-compose up -d"
echo "   Access app container: docker-compose exec app bash"
echo "   Run artisan commands: docker-compose exec app php artisan [command]"
echo "   Database access: docker-compose exec db psql -U laravel -d laravel"
echo ""
echo "🚨 Troubleshooting:"
echo "   1. Check container logs: docker-compose logs [service]"
echo "   2. Restart services: docker-compose restart"
echo "   3. Rebuild containers: docker-compose up -d --build"
echo "   4. Reset everything: docker-compose down -v && ./.setup"
echo ""

# Final application accessibility test with multiple attempts
print_step "Performing final accessibility test..."
sleep 5

for ((i=1; i<=5; i++)); do
    print_status "Testing application accessibility (attempt $i/5)..."
    
    if curl -f -s -m 10 http://localhost:8000 > /dev/null 2>&1; then
        print_success "✅ Application is accessible at http://localhost:8000"
        
        # Test a specific endpoint to ensure it's properly responding
        HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" -m 10 http://localhost:8000 2>/dev/null || echo "000")
        print_status "HTTP Response Code: $HTTP_CODE"
        
        if [ "$HTTP_CODE" = "200" ]; then
            print_success "✅ Application is responding with HTTP 200 OK"
        else
            print_warning "⚠️  Application responded with HTTP $HTTP_CODE"
        fi
        break
    else
        if [ $i -lt 5 ]; then
            print_warning "Application not ready yet, waiting 10s before retry..."
            sleep 10
        else
            print_warning "⚠️  Application might not be ready yet."
            print_status "Please wait a moment and try accessing http://localhost:8000"
            print_status "Check logs with: docker-compose logs app"
        fi
    fi
done

# Final success message
echo ""
print_success "🎉 SETUP COMPLETED SUCCESSFULLY!"
echo ""
echo "═══════════════════════════════════════════════════════════════"
echo "🌟 YOUR LARAVEL APPLICATION IS NOW READY! 🌟"
echo "═══════════════════════════════════════════════════════════════"
echo ""
echo "🌐 ACCESS YOUR APP: http://localhost:8000"
echo ""
echo "📊 WHAT'S RUNNING:"
echo "   • Laravel $(docker-compose exec -T app php artisan --version 2>/dev/null | cut -d' ' -f3 || echo '11.x')"
echo "   • PHP 8.3 with all extensions"
echo "   • PostgreSQL 15 database (migrated & seeded)"
echo "   • Redis cache server"
echo "   • Nginx web server"
echo ""
echo "🔧 USEFUL COMMANDS:"
echo "   • View logs:        docker-compose logs -f"
echo "   • Stop everything:  docker-compose down"
echo "   • Start everything: docker-compose up -d"
echo "   • Run Laravel cmds: docker-compose exec app php artisan [command]"
echo ""
print_success "🚀 Your Laravel app is ready at http://localhost:8000"

# Show quick status summary
echo ""
echo "📊 Quick Status Summary:"
docker-compose ps --format "table {{.Service}}\t{{.State}}\t{{.Ports}}" 2>/dev/null || docker-compose ps
echo ""
